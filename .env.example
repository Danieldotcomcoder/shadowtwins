# Copy to .env. Never commit .env. Secrets stay server-side and are never sent to the browser.
OPENROUTER_API_KEY=
# Optional: Groq models appear in the catalog (as groq:<model id>) when this is set.
GROQ_API_KEY=
# free (default: nothing is billed, prices shown as $0) | developer (billed at Groq's list prices)
# GROQ_PLAN=free
# Required for run controls from a browser when running in Docker (requests do not come from
# loopback inside the container). Generate e.g. with: python -c "import secrets;print(secrets.token_urlsafe(24))"
ST_OPERATOR_TOKEN=
# token (default when ST_OPERATOR_TOKEN is set) | local | readonly | open
# ST_AUTH_MODE=token
# ST_WORKER_CONCURRENCY=8
# ST_ENABLE_MOCK_PROVIDER=0
